# Copie para .env e preencha. O .env NUNCA vai para o Git (já está no .gitignore).

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Airflow (no Linux use o resultado de: id -u ; no Windows/Mac pode deixar 50000)
AIRFLOW_UID=50000

